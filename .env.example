# Node 24 LTS recommended. Run npm run admin:setup to populate local secrets.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:./data/cortex.db
ADMIN_USERNAME=operator
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Set to 1 ONLY behind your single trusted Nginx proxy; bind app to loopback.
TRUST_PROXY=0
# Production Compose only; select a long unique password in .env (never Git).
POSTGRES_USER=cortex
POSTGRES_DB=cortex
POSTGRES_PASSWORD=
# Deployment image tag (use a Git commit for reproducible rollback)
APP_TAG=local
# Optional: production bundle over HTTP only on localhost (local Docker QA).
# Public production refuses this bypass; secure cookies remain on for HTTPS.
ALLOW_INSECURE_LOCAL=0
